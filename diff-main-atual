+export const OP_KEYS = [
+  { key: '1', op: '+1' },
+  { key: '2', op: '-1' },
+  { key: '3', op: '+x' },
+  { key: '4', op: '-x' },
+  { key: '5', op: '*N' },
+  { key: '6', op: '/N' },
+];
+
+export function opFromKey(key) {
+  return OP_KEYS.find((row) => row.key === key)?.op ?? null;
